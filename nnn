<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FishMar | Pescadería y Marisquería</title>
  <link rel="stylesheet" href="css/styles.css" />
</head>
<body>

  <header class="header">
    <div class="header-inner">
      <div>
        <h1>🐟 FishMar</h1>
        <p>Pescadería y Marisquería</p>
      </div>
      <button class="ghost-btn" onclick="switchCategory('all')">Todo</button>
    </div>
  </header>

  <main class="container">
    <section class="hero-card">
      <h2>Haz tu pedido fácil y rápido</h2>
      <p>Elige tus productos, agrega al carrito y envía tu pedido por WhatsApp.</p>
    </section>

<section class="category-bar">
  <button class="category-btn active" id="btnAll" onclick="switchCategory('all')">Todo</button>
  <button class="category-btn" id="btnPescaderia" onclick="switchCategory('Pescadería')">Pescadería</button>
  <button class="category-btn" id="btnMarisqueria" onclick="switchCategory('Marisquería')">Marisquería</button>
</section>

<!-- Contenedor para subcategorías de marisquería (oculto inicialmente) -->
<div id="subcategoriaBar" class="subcategory-bar" style="display: none;">
  <button class="subcat-btn active" onclick="switchSubcategoria('')">Todas</button>
  <button class="subcat-btn" onclick="switchSubcategoria('Antojitos')">Antojitos</button>
  <button class="subcat-btn" onclick="switchSubcategoria('Mojarras')">Mojarras</button>
  <button class="subcat-btn" onclick="switchSubcategoria('Cocteles')">Cocteles</button>
  <button class="subcat-btn" onclick="switchSubcategoria('Filetes')">Filetes</button>
  <button class="subcat-btn" onclick="switchSubcategoria('Sushi y Onigiri')">Sushi y Onigiri</button>
  <button class="subcat-btn" onclick="switchSubcategoria('Camarones')">Camarones</button>
  <button class="subcat-btn" onclick="switchSubcategoria('Tostadas')">Tostadas</button>
  <button class="subcat-btn" onclick="switchSubcategoria('Ensaladas y Papas')">Ensaladas y Papas</button>
  <button class="subcat-btn" onclick="switchSubcategoria('Postres')">Postres</button>
  <button class="subcat-btn" onclick="switchSubcategoria('Paquetes para Compartir')">Paquetes para Compartir</button>
  <button class="subcat-btn" onclick="switchSubcategoria('Bebidas')">Bebidas</button>
</div>

    <section>
      <h3 class="section-title">Productos</h3>
      <div id="productos" class="products-grid"></div>
    </section>

    <section class="cart-card">
  <div class="cart-top">
    <div>
      <h3 class="section-title">Tu carrito</h3>
      <p class="cart-subtitle">Revisa tus productos antes de enviar el pedido.</p>
    </div>
    <div class="cart-count" id="cartCount">0 productos</div>
  </div>

  <div id="carrito" class="cart-list"></div>

  <div class="cart-summary">
    <div class="summary-row">
      <span>Subtotal</span>
      <strong>$<span id="subtotal">0.00</span></strong>
    </div>
    <div class="summary-row">
      <span>Envío</span>
      <strong id="shipping">GRATIS</strong>
    </div>
    <div class="summary-row total-row">
      <span>Total</span>
      <strong>$<span id="total">0.00</span></strong>
    </div>
  </div>

  <button id="btnUbicacion" class="small-btn cart-btn" onclick="obtenerUbicacion()">Usar mi ubicación 📍</button>
  <p id="ubicacion" class="muted-text">Sin ubicación capturada.</p>

  <div class="form-grid">
    <div class="field">
      <input id="nombreCliente" type="text" placeholder="Nombre del cliente" />
      <small class="error-msg" id="error-nombreCliente"></small>
    </div>

    <div class="field">
      <input id="telefonoCliente" type="tel" placeholder="Teléfono" />
      <small class="error-msg" id="error-telefonoCliente"></small>
    </div>

    <div class="field form-full">
      <textarea id="direccionCliente" placeholder="Dirección completa"></textarea>
      <small class="error-msg" id="error-direccionCliente"></small>
    </div>

    <div class="field">
      <select id="metodoPago">
        <option value="">Método de pago</option>
        <option value="Transferencia">Transferencia</option>
        <option value="Efectivo">Efectivo</option>
      </select>
      <small class="error-msg" id="error-metodoPago"></small>
    </div>

    <div class="field">
      <input id="notasPedido" type="text" placeholder="Notas adicionales (opcional)" />
      <small class="error-msg" id="error-notasPedido"></small>
    </div>
  </div>

  <button class="secondary-btn cart-btn" onclick="enviarPedido()">Enviar pedido por WhatsApp</button>
</section>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js"></script>
  <script src="js/supabase.js"></script>
  <script src="js/app.js"></script>
</body>
</html>
